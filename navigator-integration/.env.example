# Copy this file to .env and fill in real values. .env is already git-ignored at the repo root.

# From Apps and Keys in your DocuSign developer account
DS_CLIENT_ID=
DS_CLIENT_SECRET=

# Must exactly match a Redirect URI configured on the app in Apps and Keys
DS_REDIRECT_URI=http://localhost:5173/callback

# Auth endpoints - demo/sandbox by default. For production use https://account.docusign.com
DS_AUTH_BASE=https://account-d.docusign.com

# Agreement Manager (formerly Navigator) API host - demo/sandbox by default.
# For production use https://api.docusign.com
# Verify against https://developers.docusign.com/docs/agreement-manager-api/ before relying on this.
DS_AGREEMENT_MANAGER_BASE=https://api-d.docusign.com

# Verify the exact scope string against https://developers.docusign.com/platform/auth/reference/scopes/
DS_SCOPES=adm_store_unified_repo_read

PORT=5173
